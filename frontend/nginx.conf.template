limit_req_zone $binary_remote_addr zone=legacy_api:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=60r/m;
limit_req_status 429;

# Behind Railway's proxy: rate-limit per real client, not per proxy
set_real_ip_from 0.0.0.0/0;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Resolve upstreams lazily (at request time) so nginx still starts when a
# backend service is down or not yet resolvable on Railway's private network.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;

map $http_x_unused $backend_origin_raw { default "${BACKEND_URL}"; }
map $backend_origin_raw $backend_origin { default $backend_origin_raw; "~^(?<o>.*)/$" $o; }
map $http_x_unused $legacy_origin_raw { default "${LEGACY_API_URL}"; }
map $legacy_origin_raw $legacy_origin { default $legacy_origin_raw; "~^(?<o>.*)/$" $o; }

server {
    listen ${PORT} default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1000;

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /legacy-api/ {
        limit_req zone=legacy_api burst=5 nodelay;
        rewrite ^/legacy-api/(.*)$ /$1 break;
        proxy_pass $legacy_origin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
