            { "key": "cancelled_date", "value": "2026-07-01 09:00:00" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Block Doctor Time",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/set_doctor_block_time",
        "body": {
          "mode": "urlencoded",
