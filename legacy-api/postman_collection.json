      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/set_patient_schedule_update",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "schedule_id", "value": "1" },
            { "key": "visit_date", "value": "2026-07-02 11:00:00" }
          ]
        }
      },
      "response": []
